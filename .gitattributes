# Enforce consistent line endings across OSes and avoid EOL-only diffs
# All text files use LF in repo and working tree unless explicitly overridden.
* text=auto eol=lf

# Core source files
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.cxx    text eol=lf
*.h      text eol=lf
*.hh     text eol=lf
*.hpp    text eol=lf
*.hxx    text eol=lf
*.s      text eol=lf
*.S      text eol=lf
*.asm    text eol=lf
*.ld     text eol=lf
*.lds    text eol=lf

# Build/config scripts and docs
CMakeLists.txt text eol=lf
*.cmake  text eol=lf
Makefile text eol=lf
*.mk     text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf

# Windows-specific scripts keep CRLF for compatibility
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Treat common binary artifacts as binary (-text disables EOL conversion)
*.png    -text
*.jpg    -text
*.jpeg   -text
*.gif    -text
*.bmp    -text
*.ico    -text
*.pdf    -text

*.zip    -text
*.7z     -text
*.gz     -text
*.bz2    -text
*.xz     -text
*.rar    -text

*.a      -text
*.o      -text
*.so     -text
*.dll    -text
*.lib    -text
*.exe    -text

*.elf    -text
*.bin    -text
*.hex    -text
*.map    -text

*.wav    -text
*.mp3    -text
*.flac   -text

# Git/editor configs
.gitattributes text eol=lf
.gitignore    text eol=lf
.editorconfig text eol=lf
