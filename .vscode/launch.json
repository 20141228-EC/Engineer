    "version": "0.2.0",
    "configurations": [
      {
        "cwd": "${workspaceRoot}",
        "executable": "./build/FIRMWARE.elf",
        "name": "Debug with OpenOCD",
        "request": "launch",
        "type": "cortex-debug",
        "servertype": "openocd",
        "gdbTarget": "localhost:3333",
        "configFiles": [
          // "interface/cmsis-dap.cfg",
          // "target/stm32h7x.cfg"
          "Utilities/openocd-cmsisdap-stm32h7x.cfg"
        ],
        "runToEntryPoint": "main",
        "showDevDebugOutput": "none",
        "svdFile": ".\\Utilities\\SVD\\STM32H723.svd",
        "liveWatch": {
          "enabled": true,
          "samplesPerSecond": 4
        },
        // ],
        "rttConfig": {
          "enabled": true,
          "address": "auto",
          "decoders": [
            {
              "port": 0,
              "type": "console"
            }
          ]
        },
        // "armToolchainPath": "/usr/bin/gdb-multiarch",
        //"preLaunchCommands": ["Build"]
      }
    ]
  }
  