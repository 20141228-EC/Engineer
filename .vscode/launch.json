    "version": "0.2.0",
    "configurations": [
      {
        "cwd": "${workspaceRoot}",
        "executable": "./build/FIRMWARE.elf",
        "name": "Debug with OpenOCD",
        "request": "launch",
        "type": "cortex-debug",
        "device": "STM32H723VG",
        "servertype": "jlink",
        "configFiles": [
          "interface/cmsis-dap.cfg",
          "target/stm32h7x.cfg"
        ],
        "runToEntryPoint": "main",
        "showDevDebugOutput": "none",
        "svdFile": ".\\Utilities\\SVD\\STM32H723.svd",
        "liveWatch": {
          "enabled": true,
          "samplesPerSecond": 4
        },
        "rttConfig": {
          "enabled": true,
          "address": "auto",
          "decoders": [
