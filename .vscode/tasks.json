{
	
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-G", "Ninja",
                "-DTGTDIR=DM-MC02-keil"
            ],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--config", "Debug"
            ],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Configure && Build",
            "dependsOn": ["CMake Configure", "CMake Build"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },

		{
			"type": "shell",
			"label": "Cmake",
			"command": "cmake",
			"args": [
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": true
			},
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"type": "shell",
			"label": "Ninja build",
			"command": "Ninja",
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"args": [
				"-j",
				"12"
			],
		},
		{
			"label":"mkdir",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"command": "if (-Not (Test-Path build)) { mkdir build }",
		},
		{
			"label": "Build",
			"dependsOrder": "sequence",
			"dependsOn": [
				//"mkdir",
				"Cmake",
				"Ninja build"
			],
			"problemMatcher": [
				"$msCompile"
			]
		}
	]
}
