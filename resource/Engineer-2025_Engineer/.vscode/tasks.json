{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake Configure",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				".",
				"-B",
				"build",
				"-G",
				"Ninja",
				"-DTGTDIR=DM-MC02-keil"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "CMake Build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--config",
				"Debug"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Configure && Build",
			"dependsOn": [
				"CMake Configure",
				"CMake Build"
			],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "Cmake",
			"command": "cmake",
			"args": [
				".."
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": true
			},
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"type": "shell",
			"label": "Ninja build",
			"command": "Ninja",
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"args": [
				"-j",
				"12"
			]
		},
		{
			"label": "mkdir",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"command": "if (-Not (Test-Path build)) { mkdir build }"
		},
		{
			"label": "Build",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Cmake",
				"Ninja build"
			],
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"type": "cmake",
			"label": "CMake: 安装",
			"command": "install",
			"problemMatcher": [],
			"detail": "CMake 模板 安装 任务"
		},
		{
			"type": "cmake",
			"label": "CMake: 测试",
			"command": "test",
			"problemMatcher": [],
			"detail": "CMake 模板 测试 任务"
		},
		{
			"type": "cmake",
			"label": "CMake: 生成",
			"command": "build",
			"targets": [
				"[N/a - 选择工具包]"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake 模板 生成 任务"
		}
	]
}