{
    "cortex-debug.gdbPath": "arm-none-eabi-gdb",
    "editor.formatOnSave": true,
    "files.associations": {
        "cstdint": "c",
        "stm32h7xx_hal.h": "c",
        "freertos.h": "c",
        "*.tcc": "cpp",
        "deque": "cpp",
        "list": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "compare": "cpp",
        "concepts": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "map": "cpp",
        "set": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "ratio": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "limits": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "semaphore": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "typeinfo": "cpp",
        "cerrno": "cpp",
        "cfloat": "cpp",
        "climits": "cpp",
        "usbd_def.h": "c",
        "charconv": "cpp",
        "format": "cpp",
        "span": "cpp",
        "text_encoding": "cpp",
        "variant": "cpp"
    },
    "VsCodeTaskButtons.tasks": [
        {
            "text": "CMake Configure",
            "task": "CMake Build",
            "tooltip": "cmake -S . -B build -G Ninja -DTGTDIR=DM-MC02-keil",
            "command": "workbench.action.tasks.runTask",
            "color": "warning",
        },
        {
            "text": "CMake Build",
            "task": "CMake Configure",
            "tooltip": "cmake --build build --config Debug",
            "command": "workbench.action.tasks.runTask",
            "color": "warning",
        },
        {
            "text": "Configure && Build",
            "task": "Configure && Build",
            "command": "workbench.action.tasks.runTask",
            "args": "Configure && Build",
            "color": "warning",
        }
    ],
    "cmake.generator": "Ninja",
    "cmake.cmakePath": "cube-cmake",
    "cmake.configureArgs": [
        "-DCMAKE_COMMAND=cube-cmake"
    ],
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "stm32cube-ide-clangd.path": "cube",
    "stm32cube-ide-clangd.arguments": [
        "starm-clangd",
        "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/13.3.1+st.9/bin/arm-none-eabi-gcc.exe",
        "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/13.3.1+st.9/bin/arm-none-eabi-g++.exe"
    ],
    "emmet.extensionsPath": [
        "D:\\VSCode_Extensions\\"
    ],
    // 指定Clang-Format为C/C++文件的默认格式化工具
}