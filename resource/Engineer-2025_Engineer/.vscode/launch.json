        "runToEntryPoint": "main",
        "showDevDebugOutput": "none",
         "svdFile": ".\\Utilities\\SVD\\STM32H723.svd",
        "liveWatch": {
          "enabled": true,
          "samplesPerSecond": 4
        },
        //"preLaunchCommands": ["Build"]
      }
